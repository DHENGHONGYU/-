# FinSightV9 生产环境变量（构建时注入）
# 注意：VITE_ 前缀变量会暴露到前端 bundle，禁止存放敏感凭证
# API Key 请通过 UI 配置页加密存储于 localStorage（AES-GCM）

# 数据源类型：演示模式（AkShare 采集服务返回模拟数据）
VITE_DATA_SOURCE_TYPE=rest

# REST API 基础地址（同源，走 Nginx 反向代理）
VITE_API_BASE_URL=/api

# LLM 接口配置（统一为 deepseek-chat）
VITE_LLM_BASE_URL=https://api.deepseek.com
VITE_LLM_MODEL=deepseek-chat
VITE_LLM_TIMEOUT=60000

# AkShare 采集服务地址（同源走 Nginx /api/akshare 代理）
VITE_AKSHARE_BASE_URL=/api/akshare

# 应用配置
VITE_APP_TITLE=智能投研复盘系统 V9
VITE_APP_VERSION=2.0.0-demo
