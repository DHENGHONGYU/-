{
  "name": "v9-intelligent-research-review-system",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "predev": "tsc --noEmit",
    "prebuild": "npm run tsc:prod",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .ts,.tsx --max-warnings 2000",
    "lint:colors": "eslint src/ --ext .ts,.tsx --rule 'no-hardcoded-colors/no-hardcoded-tailwind-colors: error' --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "test:staged": "vitest related --run",
    "test:clean": "vitest run --exclude \"src/store/agentStore.test.ts\" --exclude \"src/blueprints/__tests__/dataRelationship.test.ts\" --exclude \"src/services/fetcher/fetcherClient.test.ts\" --exclude \"src/services/llm/llmClient.multimodel.test.ts\" --exclude \"src/components/ui/Dialog.test.tsx\" --exclude \"tests/fetcher/dataSourceProvider.test.ts\" --exclude \"tests/ui-components.test.tsx\"",
    "test:known": "vitest run src/store/agentStore.test.ts src/blueprints/__tests__/dataRelationship.test.ts src/services/fetcher/fetcherClient.test.ts src/services/llm/llmClient.multimodel.test.ts src/components/ui/Dialog.test.tsx tests/fetcher/dataSourceProvider.test.ts tests/ui-components.test.tsx",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "coverage": "vitest run --coverage",
    "tsc": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "tsc:prod": "tsc -p tsconfig.json --noEmit",
    "tsc:test": "tsc -p tsconfig.test.json --noEmit",
    "regression": "concurrently --names lint,test,audit --prefix-colors blue,yellow,magenta \"npm:lint\" \"npm:test\" \"npm:audit\" && npm run build && npm run test:e2e",
    "audit:layers": "tsx scripts/audit-layer-calls.ts",
    "audit:hardcode": "tsx scripts/audit-hardcode.ts",
    "audit:deadcode": "tsx scripts/audit-dead-code.ts",
    "audit:docs": "tsx scripts/audit-doc-sync.ts",
    "audit:routes": "tsx scripts/verify-all-routes.ts",
    "audit:mcp": "tsx scripts/audit-mcp.ts",
    "audit:token": "tsx scripts/audit-token-consumption.ts",
    "audit": "npm run audit:layers && npm run audit:hardcode && npm run audit:deadcode && npm run audit:docs && npm run audit:routes && npm run audit:mcp && npm run audit:token",
    "changelog:query": "tsx scripts/changelog-query.ts",
    "changelog:summary": "tsx scripts/changelog-query.ts --summary",
    "doc:trigger": "tsx scripts/doc-update-trigger.ts",
    "doc:check": "tsx scripts/doc-update-trigger.ts --check",
    "workflow:decide": "tsx scripts/workflow-rule-engine.ts",
    "workflow:decide:json": "tsx scripts/workflow-rule-engine.ts --json",
    "anomaly:detect": "tsx scripts/anomaly-detector.ts",
    "anomaly:detect:json": "tsx scripts/anomaly-detector.ts --json",
    "anomaly:baseline": "tsx scripts/anomaly-detector.ts --update-baseline",
    "create:mcp-server": "tsx scripts/create-mcp-server.ts",
    "validate:blueprint": "tsx scripts/validate-data-blueprint.ts",
    "validate:json": "tsx scripts/validate-json.ts",
    "verify:no-dead-refs": "node scripts/verify-no-dead-refs.mjs",
    "analyze": "npm run build && npx vite-plugin-inspect dist/stats.html",
    "prepare": "husky",
    "generate:tokens": "tsx scripts/generate-tokens.ts",
    "tokens": "tsx scripts/generate-tokens.ts",
    "pre-review": "tsx scripts/pre-review-check.ts",
    "review:checklist": "echo '📝 代码审查 Checklist: docs/CODE-REVIEW.md §2'",
    "commit": "cz"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.4",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^2.2.3",
    "react-router": "^7.0.0",
    "recharts": "^3.9.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwind-merge": "^2.5.0",
    "web-vitals": "^5.3.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-istanbul": "2.1.9",
    "@vitest/coverage-v8": "^2.1.9",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.12.0",
    "husky": "9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^17.0.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "ts-expect": "^1.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.16.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "!*.test.{ts,tsx}": [
      "bash -c 'npx tsc --noEmit'"
    ],
    "*.test.{ts,tsx}": [
      "vitest related --run"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
