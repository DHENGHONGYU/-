{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signal Data Schema",
  "description": "Schema for trading signals",
  "type": "object",
  "required": ["id", "symbol", "direction", "type", "confidence", "rationale", "snapshot", "createdAt"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Signal ID"
    },
    "symbol": {
      "type": "string",
      "description": "Stock symbol"
    },
    "direction": {
      "type": "string",
      "enum": ["buy", "sell", "hold", "watch"],
      "description": "Signal direction"
    },
    "type": {
      "type": "string",
      "description": "Signal type"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Confidence level"
    },
    "rationale": {
      "type": "string",
      "description": "Signal rationale"
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "pePercentile": { "type": ["number", "null"] },
        "pbPercentile": { "type": ["number", "null"] },
        "priceToMA20": { "type": ["number", "null"] },
        "priceToMA60": { "type": ["number", "null"] },
        "volumeRatio": { "type": ["number", "null"] },
        "rsi14": { "type": ["number", "null"] },
        "macdDirection": { "type": ["string", "null"], "enum": ["red", "green", "neutral", null] }
      }
    },
    "createdAt": {
      "type": "number",
      "description": "Timestamp when signal was created"
    },
    "strategy": {
      "type": "string",
      "description": "Strategy source identifier"
    }
  }
}