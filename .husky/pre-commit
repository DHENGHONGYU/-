#!/bin/sh
# V9 智能投研复盘系统 — 预提交门禁（Husky v9）
# 所有检查必须通过后，才能成功执行 git commit。

set -e

# 便携垫片：本机无独立 Node 安装（仅 Kimi 受管 runtime 的 npm.cmd/npx.cmd），
# Git Bash 的 sh 不按裸名解析 .cmd，此处兜底定义为 shell 函数（不影响已有正常环境）。
command -v npx >/dev/null 2>&1 || npx() { npx.cmd "$@"; }
command -v npm >/dev/null 2>&1 || npm() { npm.cmd "$@"; }

echo ""
echo "🚦 V9 预提交门禁启动 ..."
echo "================================================"

# 1. 获取当前 AGENTS.md 版本，用于提示
AGENTS_VERSION=$(grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' "AGENTS.md" | head -n 1 || echo "unknown")
echo "📋 当前 AGENTS.md 版本: $AGENTS_VERSION"

# 1.5 技能路由匹配（warn 模式，不阻断；命中记录写入 .workbuddy/skills/usage.log）
echo ""
echo "🧭 [skill-router] 技能路由匹配（提醒模式）..."
node scripts/skill-router.cjs --remind --log || true

# 2. lint-staged：仅对暂存区文件运行 ESLint --fix
echo ""
echo "🧹 [1/16] 运行 lint-staged（ESLint --fix）..."
npx lint-staged

# 3. 颜色硬编码门禁
echo ""
echo "🎨 [2/16] 运行 lint:colors（颜色硬编码检查）..."
npm run lint:colors

# 4. 生产类型检查
echo ""
echo "🔍 [3/16] 运行 tsc:prod（生产类型检查）..."
npm run tsc:prod

# 5. 分层调用审计
echo ""
echo "🏗️ [4/16] 运行 audit:layers（禁止跨层调用）..."
npm run audit:layers

# 6. 原子组件层级边界审计
echo ""
echo "⚛️ [5/16] 运行 audit:atomic（原子层级边界检查）..."
npm run audit:atomic

# 7. 数据库定义交叉引用审计（阻断：STORE_NAME / ENVELOPE_ACTION / ACL / dataLayer 暴露一致性）
echo ""
echo "🗄️ [6/16] 运行 audit:db-references（数据库定义交叉引用审计）..."
npm run audit:db-references

# 8. Agent → MCP Server 绑定一致性审计（阻断：防止悬空 Agent / UI 注册表失配）
echo ""
echo "🔗 [7/16] 运行 audit:mcp（Agent→MCP 绑定一致性 / 悬空 Agent 检查）..."
npm run audit:mcp

# 9. 文档规范检查
echo ""
echo "📋 [8/16] 运行 file:check（文档规范检查）..."
npm run file:check

# 10. 文档门禁（阻断：过期草稿/目录结构/元文档缺失）
echo ""
echo "🔒 [9/16] 运行 doc:gate（文档门禁检查）..."
npm run doc:gate

# 11. 文档同步审计
echo ""
echo "📝 [10/16] 运行 audit:docs（文档同步检查）..."
npm run audit:docs || true

# 12. 设计令牌映射校验
echo ""
echo "🎨 [11/16] 运行 verify:tokens（设计令牌映射校验）..."
npm run verify:tokens

# 13. 令牌消费审计
echo ""
echo "🪙 [12/16] 运行 audit:tokens（令牌消费检查）..."
npm run audit:tokens

# 14. JSDoc 文档门禁（基线采集，当前不阻断）
echo ""
echo "📖 [13/16] 运行 audit:jsdoc（JSDoc 覆盖检查）..."
npm run audit:jsdoc

# 15. 驾驶舱 Widget 三处注册一致性审计（阻断）
echo ""
echo "🧩 [14/16] 运行 audit:widget-registry（Widget 三处注册一致性检查）..."
npm run audit:widget-registry

# 16. AI 输出校验门禁（阻断：数值越界/未来时间戳必须拦截）
echo ""
echo "🤖 [15/16] 运行 audit:ai-output（AI 输出三道校验检查）..."
npm run audit:ai-output

# 17. ACL 权限矩阵一致性审计（阻断：action→store→module 权限配对）
echo ""
echo "🔐 [16/16] 运行 audit:acl-consistency（ACL 权限矩阵一致性检查）..."
npm run audit:acl-consistency

# 17. 文档目录-内容匹配（warn 模式，不阻断，先积累数据）
echo ""
echo "📂 [warn] 运行 audit:path-match（文档目录-内容匹配检查，warn 模式）..."
npx tsx scripts/audit-path-match.ts || true

# 18. 文档-代码双向完整性（warn 模式，不阻断）
echo ""
echo "📂 [warn] 运行 audit:doc-integrity（文档-代码双向完整性检查，warn 模式）..."
npm run audit:doc-integrity || true

# 19. 测试类型债务告警（warn 模式，不阻断；提示当前 tsc:test 错误数量）
echo ""
echo "📊 [warn] 运行 tsc:test（测试类型债务告警）..."
TS_TEST_LOG=$(mktemp /tmp/tsc-test-warn.XXXXXX.log)
npm run tsc:test > "$TS_TEST_LOG" 2>&1 || true
TS_TEST_COUNT=$(grep -c "error TS" "$TS_TEST_LOG" 2>/dev/null || echo "0")
rm -f "$TS_TEST_LOG"
if [ "$TS_TEST_COUNT" -gt 0 ]; then
  echo "⚠️  测试类型错误数: $TS_TEST_COUNT（非阻断警告，详见 tsc-gate-scope-audit §七）"
else
  echo "✅ 测试类型检查通过"
fi

echo ""
echo "================================================"
echo "✅ V9 预提交门禁全部通过（16/16 阻断项 + 3 warn 项），允许提交。"
echo ""