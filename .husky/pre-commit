#!/bin/sh
# V9 智能投研复盘系统 — 预提交门禁（Husky v9）
# 所有检查必须通过后，才能成功执行 git commit。

set +e
# 移除 set -e（与大量 || true 容错模式冲突），各步骤错误由 || true 显式处理

# 系统 Node 24 直驱函数（规避 git-bash 下受管 Node 22 npm 完全不可用的问题）
# 优先使用 nvm 安装的系统 Node 24（C:/nvm4w/nodejs/node.exe）；
# 若该路径不存在则回退到 PATH 上的 node，避免环境变动后门禁静默失效。
if [ -x "C:/nvm4w/nodejs/node.exe" ]; then
  NODE24="C:/nvm4w/nodejs/node.exe"
elif command -v node >/dev/null 2>&1; then
  NODE24="$(command -v node)"
else
  NODE24="node"
fi
TSX_RUN()  { "$NODE24" ./node_modules/tsx/dist/cli.mjs "$@"; }
ESLINT_RUN() { "$NODE24" ./node_modules/eslint/bin/eslint.js "$@"; }
TSC_RUN()  { "$NODE24" ./node_modules/typescript/bin/tsc "$@"; }
NODE_RUN() { "$NODE24" "$@"; }
VITEST_RUN() { "$NODE24" ./node_modules/vitest/vitest.mjs "$@"; }

# 阻断助手：任一 P0 门禁失败即拦截提交。
# 修正 set +e 下的"假绿灯"——脚本结尾 echo 退出码恒为 0，必须有显式失败出口。
BLOCK() {
  "$@"
  local rc=$?
  if [ $rc -ne 0 ]; then
    echo ""
    echo "❌ 门禁失败，提交被拦截：请先修复上述问题再提交。"
    echo "   （失败命令：$*）"
    exit 1
  fi
  return 0
}

# 便携垫片：保留以防其他 npx 调用
command -v npx >/dev/null 2>&1 || npx() { npx.cmd "$@"; }

echo ""
echo "🚦 V9 预提交门禁启动 ..."
echo "================================================"

# 0. 提交作用域守卫 v2（Commit Scope Guard）—— 堵上"提交卫生"盲点
#    规则 1：单次提交文件数 ≤ 30（BLOCK）
#    规则 2：禁止跨层混合提交（≥3 个顶层域 → BLOCK）
#    规则 3：src/ + docs/ 大量删除（>30 项）→ BLOCK
#    规则 4：禁止临时产物混入（test-output.txt 等 → BLOCK）
echo ""
echo "🎯 [0/19] 提交作用域守卫 v2（文件数 ≤30 + 跨层检测 + 产物过滤）..."
sh scripts/audit/audit-commit-scope.sh
SCOPE_GUARD_EXIT=$?
if [ "$SCOPE_GUARD_EXIT" -ne 0 ]; then
  echo "   💡 修复建议: 使用 'git commit --only <paths>' 精确控制提交范围，或拆分为多个原子提交。"
  exit 1
fi

# 1. 获取当前 AGENTS.md 版本，用于提示
AGENTS_VERSION=$(grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' "AGENTS.md" | head -n 1 || echo "unknown")
echo "📋 当前 AGENTS.md 版本: $AGENTS_VERSION"

# 1.5 技能路由匹配（warn 模式，不阻断）
echo ""
echo "🧭 [skill-router] 技能路由匹配（提醒模式）..."
node scripts/skill-router.cjs --remind --log || true

# 2. 环境路径守卫：拦截写死 C:/Users/xxx 的提交
echo ""
echo "🛡️  [env-check] 运行环境路径守卫（拦截硬编码用户路径）..."
NODE_RUN scripts/env-path-guard.cjs --ci --staged
ENV_CHECK_EXIT=$?
if [ "$ENV_CHECK_EXIT" -ne 0 ]; then
  echo ""
  echo "❌ env-path-guard 拦截：提交中包含写死的 Windows 用户目录绝对路径。"
  echo "   请先修正后再提交。详情见上方扫描报告。"
  exit 1
fi

# 2.5 密钥/敏感信息扫描（SAST-lite，已本地校验 0 误报，升级为 BLOCK）
echo ""
echo "🔑 [secrets] 运行 audit:secrets（密钥/敏感信息扫描，BLOCK）..."
BLOCK TSX_RUN scripts/audit/audit-secrets.ts

# 3. lint-staged：仅对暂存区文件运行 ESLint --fix
echo ""
echo "🧹 [2/19] 运行 lint-staged（ESLint --fix）..."
npx lint-staged

# 3. 颜色硬编码门禁
echo ""
echo "🎨 [3/19] 运行 lint:colors（颜色硬编码检查）..."
ESLINT_RUN --config eslint.colors.config.js src/

# 4. 生产类型检查
echo ""
echo "🔍 [4/19] 运行 tsc:prod（生产类型检查）..."
BLOCK TSC_RUN -p tsconfig.prod.json --noEmit

# 5. 分层调用审计
echo ""
echo "🏗️ [5/19] 运行 audit:layers（禁止跨层调用）..."
BLOCK TSX_RUN scripts/audit/audit-layer-calls.ts

# 6. 原子组件层级边界审计
echo ""
echo "⚛️ [6/19] 运行 audit:atomic（原子层级边界检查）..."
BLOCK TSX_RUN scripts/audit/audit-atomic.ts

# 7. 数据库定义交叉引用审计
echo ""
echo "🗄️ [7/19] 运行 audit:db-references（数据库定义交叉引用审计）..."
BLOCK TSX_RUN scripts/audit/audit-db-references.ts

# 8. Agent → MCP Server 绑定一致性审计（警告模式：2 个预存 direct-service-import 待修复，非本次引入，不阻断）
echo ""
echo "🔗 [8/19] 运行 audit:mcp（Agent→MCP 绑定一致性 / 悬空 Agent 检查）..."
TSX_RUN scripts/audit/audit-mcp.ts || true

# 9. 文档规范检查（告警模式：41 个预存白名单违规待修复，含 docs-backup-*/、.gitattributes、tsconfig.prod.json 等）
echo ""
echo "📋 [9/19] 运行 file:check（文档规范检查）..."
NODE_RUN scripts/docs-tool/check-docs.js || true

# 10. 文档门禁
echo ""
echo "🔒 [10/19] 运行 doc:gate（文档门禁检查）..."
TSX_RUN scripts/doc-gatekeeper.ts

# 11. 文档同步审计（warn 模式）
echo ""
echo "📝 [11/20] 运行 audit:docs（文档同步检查）..."
TSX_RUN scripts/audit/audit-doc-sync.ts && TSX_RUN scripts/audit/audit-version-drift.ts || true

# 12. doc_id 注册表反向一致性审计（B 系统方案 · 差分扫描 + 违规分级）
#     - --changed-only：仅校验本次提交涉及的 .md 文件，避免并发 Agent 文档 churn 无辜 BLOCK 个人全绿提交
#     - 阻断型(BLOCKING)：missing-file（真实断链）；警告型(WARNING)：unregistered-doc / no-doc-id / id-mismatch（transient 状态）
#     - 退出码仅由阻断型违规决定，警告型只在报告中提示
echo ""
echo "📋 [12/20] 运行 audit:doc-id-reverse（doc_id 反向一致性，BLOCK 仅阻断 missing-file，差分扫描）..."
BLOCK TSX_RUN scripts/audit/audit-doc-id-reverse.ts --changed-only

# 13. 设计令牌映射校验
echo ""
echo "🎨 [13/20] 运行 verify:tokens（设计令牌映射校验）..."
TSX_RUN scripts/verify-design-tokens.ts

# 14. 令牌消费审计
echo ""
echo "🪙 [14/20] 运行 audit:tokens（令牌消费检查）..."
TSX_RUN scripts/other/token-scan.cjs

# 15. JSDoc 文档门禁（基线采集，当前不阻断）
echo ""
echo "📖 [15/20] 运行 audit:jsdoc（JSDoc 覆盖检查）..."
TSX_RUN scripts/audit/audit-jsdoc.ts || true

# 16. 驾驶舱 Widget 三处注册一致性审计（tsx 段错误容错）
echo ""
echo "🧩 [16/20] 运行 audit:widget-registry（Widget 三处注册一致性检查）..."
TSX_RUN scripts/audit/audit-widget-registry.ts || true

# 17. AI 输出校验门禁（tsx 段错误容错）
echo ""
echo "🤖 [17/20] 运行 audit:ai-output（AI 输出三道校验检查）..."
TSX_RUN scripts/audit/audit-ai-output.ts || true

# 18. ACL 权限矩阵一致性审计（tsx 段错误容错）
echo ""
echo "🔐 [18/20] 运行 audit:acl-consistency（ACL 权限矩阵一致性检查）..."
TSX_RUN scripts/audit/audit-acl-consistency.ts || true

# 19. 组件注册表一致性审计（registry P0 阻断）
#     用户要求纳入 pre-commit 的三条门禁之 #2（对应 npm run audit:registry）
#     - 正向：已注册组件的 sourcePath 文件是否存在
#     - 反向：存在的组件源文件是否已在 registry 中注册
echo ""
echo "🧩 [19/20] 运行 audit:registry（组件注册表一致性审计，P0 BLOCK）..."
BLOCK TSX_RUN scripts/audit/audit-registry.ts

# 20. 注册表契约测试（registryContract P0 阻断）
#     用户要求纳入 pre-commit 的三条门禁之 #3（对应 vitest run registryContract.test.ts）
#     - 白名单组件不可在 page/app 层直接 JSX 引用
#     - reserved components 的 consumers=pending-integration 约束
echo ""
echo "🧪 [20/20] 运行 vitest registryContract（注册表契约，P0 BLOCK）..."
BLOCK VITEST_RUN run src/components/registry/registryContract.test.ts

# 21. RAG 增强评分门禁（Phase 5 CI 集成）
#     当 RAG 相关源文件（ragRetriever.ts / enhancer.ts / hallucinationDetector.ts /
#     ragE2EPipeline.test.ts / ragPerformance.bench.test.ts / ragRealLLMIntegration.test.ts /
#     ragHallucinationRegression.test.ts）被暂存时，运行 Golden Dataset 回归 + 幻觉检测
#     门禁不通过则 BLOCK 提交
echo ""
echo "🔬 [21/20] 运行 RAG 幻觉检测门禁（条件触发）..."
RAG_FILES_CHANGED=$(git diff --cached --name-only | grep -E 'src/services/scoring/v6-engine/(ragRetriever\.ts|enhancer\.ts|hallucinationDetector\.ts|ragE2EPipeline\.test\.ts|ragPerformance\.bench\.test\.ts|ragRealLLMIntegration\.test\.ts|ragHallucinationRegression\.test\.ts)' || true)
if [ -n "$RAG_FILES_CHANGED" ]; then
  echo "   📋 检测到 RAG 相关文件变更:"
  echo "$RAG_FILES_CHANGED" | sed 's/^/      /'
  echo "   🧪 运行 Golden Dataset 回归 + 幻觉检测..."
  BLOCK VITEST_RUN run src/services/scoring/v6-engine/ragHallucinationRegression.test.ts
else
  echo "   ✅ 无 RAG 相关文件变更，跳过门禁"
fi

# 22. AGENTS.md 契约 ↔ 真相源 一致性（P0 条件触发）
#     当 AGENTS.md / src/config/dbConfig.ts / src/config/mcpServerRegistry.ts /
#     src/constants/cockpit.constants.ts / tsconfig.prod.json / tsconfig.test.json
#     任一暂存时执行；P0 漂移（DB_VERSION/Store数/MCP条目/USER_SCENES）→ BLOCK。
#     --changed 由脚本内部做暂存过滤，无需此处再套条件（双保险）。
echo ""
echo "🗂️  [22/20] 运行 audit:agents-consistency（契约一致性，条件触发，P0 BLOCK）..."
BLOCK TSX_RUN scripts/audit/audit-agents-consistency.ts --changed

# 20. 文档目录-内容匹配（warn 模式）
echo ""
echo "📂 [warn] 运行 audit:path-match（文档目录-内容匹配检查，warn 模式）..."
TSX_RUN scripts/audit/audit-path-match.ts || true


echo ""
echo "📂 [warn] 运行 audit:doc-integrity（文档-代码双向完整性检查，warn 模式）..."
TSX_RUN scripts/audit/audit-doc-integrity.ts || true


echo ""
echo "📊 [warn] 运行 tsc:test（测试类型债务告警）..."
# Windows / cross-platform: prefer mktemp with fallback (avoid /tmp/ on Windows)
if command -v mktemp >/dev/null 2>&1; then
  TS_TEST_LOG=$(mktemp 2>/dev/null || mktemp -t tsc-test-warn 2>/dev/null || echo "$TEMP/tsc-test-warn.$$.log")
else
  TS_TEST_LOG="temp/tsc-test-warn.$$.log"
  mkdir -p "$(dirname "$TS_TEST_LOG")" 2>/dev/null || true
fi
TSC_RUN -p tsconfig.test.json --noEmit > "$TS_TEST_LOG" 2>&1 || true
TS_TEST_COUNT=$(grep -c "error TS" "$TS_TEST_LOG" 2>/dev/null || echo "0")
rm -f "$TS_TEST_LOG"
if [ "$TS_TEST_COUNT" -gt 0 ]; then
  echo "⚠️  测试类型错误数: $TS_TEST_COUNT（非阻断警告，详见 tsc-gate-scope-audit §七）"
else
  echo "✅ 测试类型检查通过"
fi

# 21. 文档健康度审计提醒（月度/季度，非阻断）
# 22. 硬编码审计（warn 模式：仅提醒 Critical/Major，不阻断）
#     目标：将 audit:hardcode 以 warn 模式纳入 pre-commit，逐步收敛 Critical/Major 至 0
#     当前基线：0 Critical / 0 Major / 139 Warning / 5 Info
echo ""
echo "🎨 [warn] 运行 audit:hardcode（硬编码审计，warn 模式）..."
HARDCODE_REPORT=$(TSX_RUN scripts/audit/audit-hardcode.ts 2>&1)
HARDCODE_EXIT=$?
if [ "$HARDCODE_EXIT" -eq 2 ]; then
  echo "   ⚠️  audit:hardcode 执行错误（exit=2），跳过本次告警"
elif [ "$HARDCODE_EXIT" -ne 0 ]; then
  HARDCODE_CRITICAL=$(echo "$HARDCODE_REPORT" | grep -oE 'Critical:\s*[0-9]+' | grep -oE '[0-9]+')
  HARDCODE_MAJOR=$(echo "$HARDCODE_REPORT" | grep -oE 'Major:\s*[0-9]+' | grep -oE '[0-9]+')
  HARDCODE_WARNING=$(echo "$HARDCODE_REPORT" | grep -oE 'Warning:\s*[0-9]+' | grep -oE '[0-9]+')
  CRITICAL_COUNT=${HARDCODE_CRITICAL:-0}
  MAJOR_COUNT=${HARDCODE_MAJOR:-0}
  WARNING_COUNT=${HARDCODE_WARNING:-0}
  echo "   ⚠️ 硬编码审计发现: Critical=$CRITICAL_COUNT / Major=$MAJOR_COUNT / Warning=$WARNING_COUNT"
  if [ "$CRITICAL_COUNT" -gt 0 ] || [ "$MAJOR_COUNT" -gt 0 ]; then
    echo "   🔴 Critical/Major 项未清零，建议尽快修复后再提交"
    echo "   💡 运行 npm run audit:hardcode 查看详情"
  fi
else
  echo "   ✅ 硬编码审计通过（0 Critical / 0 Major）"
fi

echo ""
echo "📅 [warn] 文档健康度审计提醒..."
CURRENT_DAY=$(date +%d 2>/dev/null || echo "01")
CURRENT_MONTH=$(date +%m 2>/dev/null || echo "01")
# 每月1号提醒月度审计
if [ "$CURRENT_DAY" = "01" ]; then
  echo "   📋 今天是月初 ($(date +%Y-%m-%d 2>/dev/null))，建议执行月度文档健康度审计："
  echo "      npm run audit:doc-health:monthly"
  # 季度首月（1/4/7/10月）提醒季度审计
  if [ "$CURRENT_MONTH" = "01" ] || [ "$CURRENT_MONTH" = "04" ] || [ "$CURRENT_MONTH" = "07" ] || [ "$CURRENT_MONTH" = "10" ]; then
    echo "   📊 今天是季度首月，建议执行季度全量文档健康度审计："
    echo "      npm run audit:doc-health:quarterly"
  fi
else
  # 检查上次审计报告日期，超过30天提醒
  LATEST_AUDIT=$(ls -t docs/reports/audit/doc-health-orchestrator-*.md 2>/dev/null | head -n 1)
  if [ -n "$LATEST_AUDIT" ]; then
    AUDIT_DATE=$(echo "$LATEST_AUDIT" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}')
    AUDIT_EPOCH=$(date -d "$AUDIT_DATE" +%s 2>/dev/null || echo "0")
    NOW_EPOCH=$(date +%s 2>/dev/null || echo "0")
    DAYS_SINCE=$(( (NOW_EPOCH - AUDIT_EPOCH) / 86400 ))
    if [ "$DAYS_SINCE" -gt 30 ] 2>/dev/null; then
      echo "   ⚠️ 上次文档健康度审计已过去 $DAYS_SINCE 天（$AUDIT_DATE），建议执行："
      echo "      npm run audit:doc-health:monthly"
    fi
  else
    echo "   ℹ️ 尚未执行过文档健康度审计，建议首次执行："
    echo "      npm run audit:doc-health:quarterly"
  fi
fi

echo ""
echo "================================================"
echo "✅ V9 预提交门禁通过：核心 P0 门禁（secrets / tsc:prod / layers / atomic / db-references / doc-id-reverse / audit:registry / vitest registryContract）已真阻断；hardcode/hardcode 审计为 warn 模式（0 Critical / 0 Major 基线）。允许提交。"
echo ""
