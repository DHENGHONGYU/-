#!/bin/sh
# V9 智能投研复盘系统 — commit-msg hook (Husky v9)
# 校验 Git Commit Message 中的 Jira Key 格式
#
# 校验规则:
#   1. Subject 行不超过 50 字符（警告，不阻止）
#   2. Subject 行以合法 type 开头（feat/fix/docs/chore/refactor/test/ci/style/perf/build/revert）
#   3. Footer 行（Refs/Closes/Fixes/Resolves/Issue/Related/See）必须包含 Jira Key（PROJECT-NNN 格式）
#   4. Jira Key 格式: 2~10 位大写字母 + 连字符 + 数字（如 FIN-123, FIN-TS-004）
#   5. 不允许在 footer 中使用内部编号（P0/P1/V9-XXX/TD-NNN）代替 Jira Key
#
# 退出码:
#   0 = 校验通过
#   1 = 校验失败（阻止提交）
#
# 注意: 本脚本由 husky 的 .husky/_/h 通过 `sh -e` 执行，必须兼容 POSIX sh。
#       禁止使用 bash 特性: pipefail、<<<、process substitution、[[ ]] 等。

set -eu

COMMIT_MSG_FILE="$1"
# 读取内容并去除 BOM（PowerShell utf8 编码可能带入 BOM）
CONTENT=$(sed '1s/^\xEF\xBB\xBF//' "$COMMIT_MSG_FILE")
ERRORS=0
WARNINGS=0

# ── 颜色输出 ──
RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

error() {
  printf "${RED}  ✗ %s${NC}\n" "$1"
  ERRORS=$((ERRORS + 1))
}

warn() {
  printf "${YELLOW}  ⚠ %s${NC}\n" "$1"
  WARNINGS=$((WARNINGS + 1))
}

success() {
  printf "${GREEN}  ✓ %s${NC}\n" "$1"
}

# ═══════════════════════════════════════════════════════════════
# 校验逻辑
# ═══════════════════════════════════════════════════════════════

echo ""
echo "=== commit-msg hook 校验 ==="

# ── 1. Subject 行校验 ──
SUBJECT=$(echo "$CONTENT" | head -1)

# 1a. Subject 长度（50 字符警告，72 字符错误）
SUBJ_LEN=${#SUBJECT}
if [ "$SUBJ_LEN" -gt 72 ]; then
  error "Subject 行长度 ${SUBJ_LEN} 字符，超过 72 字符上限"
elif [ "$SUBJ_LEN" -gt 50 ]; then
  warn "Subject 行长度 ${SUBJ_LEN} 字符，建议不超过 50 字符"
fi

# 1b. Subject 格式: type(scope): description 或 type: description
if ! echo "$SUBJECT" | grep -qE '^(feat|fix|docs|chore|refactor|test|ci|style|perf|build|revert)(\(.+\))?: .+'; then
  error "Subject 行不符合 Conventional Commits 格式: $SUBJECT"
  echo "         期望格式: type(scope): description"
  echo "         合法 type: feat, fix, docs, chore, refactor, test, ci, style, perf, build, revert"
else
  success "Subject 格式正确"
fi

# 1c. Scope 内部编号校验（防止 fix(p0) 这种小写/大写内部编号作为 scope）
#     提取 scope: type(scope): desc → scope
SCOPE=$(echo "$SUBJECT" | sed -nE 's/^(feat|fix|docs|chore|refactor|test|ci|style|perf|build|revert)\((.+)\): .*/\2/p')
if [ -n "$SCOPE" ]; then
  # 检查 scope 是否包含内部编号（p0, P0, p1-2, P1-2 等，不区分大小写）
  # 正则: p 前面不能是字母或连字符（避免误匹配 app0 和 FIN-P0 中的 P0），p 后面是数字 0-6
  if echo "$SCOPE" | grep -qiE '(^|[^a-zA-Z-])p[0-6]([^0-9a-zA-Z-]|$)|(^|[^a-zA-Z-])p[0-6]-[0-9]+'; then
    error "Scope 包含内部编号: '$SCOPE'，请使用 Jira Key 或功能模块名"
    echo "         内部编号示例: p0, P0, p1-2, P1-2"
    echo "         合规示例: fix(FIN-P0), fix(auth), fix(store)"
  fi
fi

# ── 2. 提取 Footer 行 ──
FOOTER_LINES=$(echo "$CONTENT" | grep -E '^(Refs|Closes|Fixes|Resolves|Issue|Related|See):' || true)

if [ -z "$FOOTER_LINES" ]; then
  # 无 footer 行，跳过 footer 校验（非强制要求）
  warn "未找到 Footer 引用行（Refs/Closes/Fixes/Resolves），建议添加 Jira Key 关联"
else
  # ── 3. Footer Jira Key 格式校验 ──
  # Jira Key 格式: 2~10 位大写字母 + 连字符 + 数字
  JIRA_KEY_REGEX='[A-Z][A-Z0-9_]{1,9}-[0-9]+'

  # POSIX sh 不支持 <<< here-string，用临时文件遍历
  TMP_FOOTERS=$(mktemp /tmp/commit-msg-footers.XXXXXX)
  echo "$FOOTER_LINES" > "$TMP_FOOTERS"
  while IFS= read -r line; do
    [ -z "$line" ] && continue

    # 提取 footer 关键字和值
    FOOTER_TYPE=$(echo "$line" | grep -oE '^(Refs|Closes|Fixes|Resolves|Issue|Related|See):' | tr -d ':')
    FOOTER_VALUE=$(echo "$line" | sed -E 's/^(Refs|Closes|Fixes|Resolves|Issue|Related|See)://; s/^ *//')

    # 先检查是否包含内部编号（V9-XXX-NNN / 裸 P{N} / TD-NNN）
    # 注意: P 前面不能是大写字母或连字符，避免匹配 FIN-P0-1 中的 P0-1
    if echo "$FOOTER_VALUE" | grep -qE '(^|[^A-Z-])V9-[A-Z]+-[0-9]|(^|[^A-Z-])P[0-6]([^0-9-]|$)|(^|[^A-Z-])P[0-6]-[0-9]+([^0-9-]|$)|(^|[^A-Z-])TD-[0-9]+'; then
      error "Footer '$FOOTER_TYPE' 使用了内部编号，请替换为 Jira Key"
      echo "         当前值: $FOOTER_VALUE"
      echo "         内部编号示例: P0, P1-2, V9-TS-004, TD-009"
      echo "         Jira Key 示例: FIN-P0, FIN-P1-2, FIN-TS-004, FIN-TD-009"
    # 再检查是否包含合规 Jira Key（需前有边界，避免匹配 V9-TS-004 中的 TS-004）
    elif echo "$FOOTER_VALUE" | grep -qE "(^|[^A-Z0-9])${JIRA_KEY_REGEX}"; then
      success "Footer '$FOOTER_TYPE' 包含 Jira Key: $(echo "$FOOTER_VALUE" | grep -oE "$JIRA_KEY_REGEX" | head -1)"
    else
      error "Footer '$FOOTER_TYPE' 缺少 Jira Key 格式 (PROJECT-NNN)"
      echo "         当前值: $FOOTER_VALUE"
      echo "         期望格式: $FOOTER_TYPE: FIN-123 或 $FOOTER_TYPE: FIN-TS-004"
    fi

    # 检查 commit hash 引用（合规，仅提示）
    if echo "$FOOTER_VALUE" | grep -qE '[0-9a-f]{7,40}'; then
      warn "Footer '$FOOTER_TYPE' 引用了 commit hash，建议同时关联 Jira Key"
    fi

  done < "$TMP_FOOTERS"
  rm -f "$TMP_FOOTERS"
fi

# ── 4. Body 行宽度校验（72 字符警告）──
BODY_LINES=$(echo "$CONTENT" | tail -n +2 | grep -v '^$' | grep -v '^(Refs|Closes|Fixes|Resolves|Issue|Related|See):' || true)
if [ -n "$BODY_LINES" ]; then
  LONG_LINES=$(echo "$BODY_LINES" | awk 'length > 72 {print NR": "$0}' || true)
  if [ -n "$LONG_LINES" ]; then
    LONG_COUNT=$(echo "$LONG_LINES" | wc -l)
    warn "Body 中有 ${LONG_COUNT} 行超过 72 字符，建议换行"
  fi
fi

# ═══════════════════════════════════════════════════════════════
# 结果汇总
# ═══════════════════════════════════════════════════════════════

echo ""
if [ "$ERRORS" -gt 0 ]; then
  printf "${RED}=== 校验失败: %d 个错误, %d 个警告 ===${NC}\n" "$ERRORS" "$WARNINGS"
  echo ""
  exit 1
elif [ "$WARNINGS" -gt 0 ]; then
  printf "${YELLOW}=== 校验通过（有 %d 个警告）===${NC}\n" "$WARNINGS"
  echo ""
  exit 0
else
  printf "${GREEN}=== 校验通过 ===${NC}\n"
  echo ""
  exit 0
fi
