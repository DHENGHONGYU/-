# =============================================================================
# npm 安全配置 — 安全优先策略
# =============================================================================
# 作用范围：当前项目（项目级 .npmrc 优先于用户级和全局配置）
# 策略：受信任源 + 禁止安装脚本 + 强制审计 + 版本锁定
# =============================================================================

# --- 受信任源 ---
# 锁定 registry 为国内镜像（加速），如需切换官方源改为 https://registry.npmjs.org
registry=https://registry.npmmirror.com

# --- 安装脚本控制 ---
# 禁止执行包的 pre/post install 脚本（防止供应链攻击）
# 注意：部分原生模块（如 node-sass）可能需要此选项，按需临时开启
ignore-scripts=true

# --- 审计与漏洞检查 ---
# npm audit 的最低报告级别（low/moderate/high/critical）
audit-level=high

# --- 版本锁定 ---
# 保存精确版本号（不用 ^ 或 ~），防止依赖漂移引入未审计版本
save-exact=true

# --- 签名验证 ---
# 要求安装包有签名（npm 当前支持 provenance，需 registry 支持）
# 如 npmmirror 不支持 provenance，可注释此行
# verify-signatures=true

# --- 进程数限制 ---
# 限制并发下载数，便于审计和排查
maxsockets=5
