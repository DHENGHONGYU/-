# 数据源类型：mock | rest | websocket
# 开发环境默认 mock，生产环境切换为 rest 或 websocket
VITE_DATA_SOURCE_TYPE=mock

# REST API 基础地址（VITE_DATA_SOURCE_TYPE=rest 时使用）
VITE_API_BASE_URL=/api

# WebSocket 地址（VITE_DATA_SOURCE_TYPE=websocket 时使用）
VITE_WS_URL=ws://localhost:8080/ws

# LLM 接口配置
VITE_LLM_BASE_URL=https://api.deepseek.com/v1
VITE_LLM_API_KEY=your-api-key-here
VITE_LLM_MODEL=deepseek-chat

# 本地 Python 数据采集服务地址
VITE_AKSHARE_BASE_URL=http://localhost:8000
