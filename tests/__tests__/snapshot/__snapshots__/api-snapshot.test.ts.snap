// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`API 响应快照测试 > 应该匹配 BridgeQueryResult 成功响应的快照 1`] = `
{
  "data": {
    "count": 1,
    "stocks": [
      {
        "changePercent": 2.5,
        "code": "000001",
        "name": "平安银行",
        "price": 12.34,
      },
    ],
  },
  "fromCache": false,
  "success": true,
  "traceId": StringMatching /\\^test-trace-id-\\\\d\\+\\$/,
}
`;

exports[`API 响应快照测试 > 应该匹配 BridgeQueryResult 错误响应的快照 1`] = `
