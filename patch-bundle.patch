+import { dataLayer } from '@/data/dataLayer'
+import {
+  getNextStatuses,
+  getPoolLabel,
+  getTransitionLabel,
+  isValidTransition,
+} from '@/core/poolTransitionEngine'
+import type { DataLayerResult, Stock } from '@/data/types'
+
+export interface PoolTransitionOption {
