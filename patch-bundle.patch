+
+const InputApp = React.lazy(() => import('@/apps/input/InputApp'))
+const AnalysisApp = React.lazy(() => import('@/apps/analysis/AnalysisApp'))
+const TradingApp = React.lazy(() => import('@/apps/trading/TradingApp'))
