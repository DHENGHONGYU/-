+}
+
+export async function migrateScoreDocs(
+  traceId: string,
+  transformed: V9ImportShape,
+  options: MigrationOptions,
+): Promise<MigrationReport['details'][number]> {
+  const docs = [...transformed.scoreDocsFromScores, ...transformed.scoreDocs]
+  return migrateOne(
