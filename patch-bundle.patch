+}
+
+/** 内部文件库统计 */
+export interface FileLibraryStats {
+  totalDocs: number
+  totalStocks: number
+  totalVersions: number
+  avgComposite: number
+  coreStocks: number
+  lastUpdate: string
+}
+
+// ============================================================
+// V6 Pro 迁移：策略快照与版本管理
+// ============================================================
+
+/** 策略分组快照 */
+export interface StrategyGroupSnapshot {
