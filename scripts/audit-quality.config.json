{
  "_comment": "audit-quality-enhanced v1.4 规则配置。所有字段均可选，缺省即启用全部规则并采用内置阈值。将此文件置于 scripts/ 下自动加载，或用 --config <path> 指定。",
  "rules": {
    "_comment": "规则开关：显式设为 false 可关闭某条规则；缺省（不出现或 true）即启用。",
    "smell:unused-import": true,
    "smell:unused-var": true,
    "smell:unused-fn": true,
    "sec:sql-injection": true,
    "smell:hooks-missing-deps": true,
    "perf:nested-loops": true,
    "smell:deep-nesting": true,
    "smell:long-fn": true,
    "defect:loose-equality": true,
    "defect:empty-catch": true,
    "defect:assign-in-cond": true,
    "defect:switch-no-default": true,
    "defect:parseint-no-radix": true,
    "smell:explicit-any": true,
    "smell:debug-log": true,
    "smell:commented-code": true,
    "sec:hardcoded-secret": true,
    "sec:command-injection": true,
    "sec:eval": true,
    "sec:new-function": true,
    "sec:inner-html": true,
    "sec:dangerous-html": true,
    "perf:sync-in-loop": true,
    "perf:json-in-loop": true,
    "perf:await-in-loop": true,
    "arch:circular-dep": true,
    "arch:unused-export": true,
    "arch:orphan-module": true,
    "defect:unreachable-code": true,
    "defect:switch-fallthrough": true,
    "smell:nested-ternary": true,
    "smell:boolean-param": true,
    "smell:todo-fixme": true,
    "sec:open-redirect": true,
    "sec:regex-injection": true,
    "perf:array-method-chain": true,
    "perf:string-concat-in-loop": true,
    "arch:deep-import": true,
    "arch:god-module": true,
    "norm:interface-prefix": true,
    "norm:var-keyword": true
  },
  "thresholds": {
    "_comment": "代码异味 / 架构阈值。",
    "fnLenWarn": 100,
    "fnLenMajor": 200,
    "maxNesting": 4,
    "godModuleExports": 25,
    "godModuleLines": 800,
    "deepImportUpLevels": 3
  },
  "directories": {
    "_comment": "按目录前缀覆盖阈值（最长匹配胜出）。示例：对测试目录放宽长函数限制。",
    "src/tests": { "fnLenWarn": 150, "fnLenMajor": 300 },
    "src/showcase": { "fnLenWarn": 200 }
  },
  "arch": {
    "_comment": "跨文件架构检测可选项。allowUnusedExportsPrefixes：匹配的相对路径前缀不报 arch:unused-export，收敛公共类型/常量模块的噪音。",
    "allowUnusedExportsPrefixes": ["src/types", "src/constants"]
  }
}
