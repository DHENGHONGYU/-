+    it('null/undefined 返回默认值', () => {
+      expect(toSafeString(null)).toBe('')
+      expect(toSafeString(null, 'unknown')).toBe('unknown')
+      expect(toSafeString(undefined, 'N/A')).toBe('N/A')
+    })
+  })
+})
