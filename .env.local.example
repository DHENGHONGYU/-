# ============================================================
# V9 智能投研复盘系统 - 本地环境变量配置
# ============================================================
# 此文件为配置模板，实际配置请复制为 .env.local 并填写真实值
# .env.local 已被 .gitignore 忽略，不会提交到代码仓库
# ============================================================

# -------------------- LLM API 配置 --------------------
# LLM 服务 Base URL（末尾不含 /，代码会自动拼接 /v1/chat/completions）
VITE_LLM_BASE_URL=https://api.deepseek.com

# 安全提示：API Key 不再通过环境变量配置
# VITE_ 前缀变量会暴露到前端 bundle，存在安全风险
# API Key 请通过 UI 配置页输入，将使用 AES-GCM 加密存储于 localStorage
# 对应 API：setLlmApiKey(key) / getLlmApiKeyAsync() / isLlmApiKeyConfigured()

# -------------------- MCP 服务配置 --------------------
# Doubao ARK API Key（Trae MCP doubao 服务）
# .trae/mcp.json 通过 ${ARK_API_KEY} 引用此变量
ARK_API_KEY=

# 默认模型
VITE_LLM_MODEL=deepseek-chat

# 请求超时（ms）
VITE_LLM_TIMEOUT=60000

# -------------------- 数据源配置 --------------------
# 数据源类型：mock | rest | websocket
VITE_DATA_SOURCE_TYPE=mock

# REST API 基础地址（VITE_DATA_SOURCE_TYPE=rest 时使用）
VITE_API_BASE_URL=/api

# WebSocket 地址（VITE_DATA_SOURCE_TYPE=websocket 时使用）
VITE_WS_URL=ws://localhost:8080/ws

# -------------------- 数据采集服务 --------------------
# 本地 Python 数据采集服务地址（可选）
VITE_AKSHARE_BASE_URL=http://localhost:8000

# -------------------- 应用配置 --------------------
VITE_APP_TITLE=V9智能投研复盘系统
VITE_APP_VERSION=0.9.7
