{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "mainEntryPointFilePath": "./dist/index.d.ts",
  "docModel": {
    "enabled": true,
    "apiJsonFilePath": "./docs/reports/api-model.json"
  },
  "dtsRollup": {
    "enabled": true,
    "untrimmedFilePath": "./dist/v9-intelligent-research-review-system.d.ts"
  },
  "apiReport": {
    "enabled": true,
    "reportFilePath": "./docs/reports/api-report.md",
    "reportTempFilePath": "./docs/reports/api-report.temp.md"
  },
  "messages": {
    "compilerMessageReporting": {
      "default": {
        "logLevel": "warning"
      }
    },
    "extractorMessageReporting": {
      "default": {
        "logLevel": "warning"
      },
      "ae-missing-release-tag": {
        "logLevel": "warning"
      },
      "ae-unresolved-external-reference": {
        "logLevel": "warning"
      }
    },
    "tsdocMessageReporting": {
      "default": {
        "logLevel": "warning"
      }
    }
  },
  "projectFolder": ".",
  "newlineKind": "lf",
  "outputFolder": "./dist"
}